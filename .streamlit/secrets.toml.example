# Paste this template into Streamlit Community Cloud > App settings > Secrets.
# Never commit real secret values.

ENVIRONMENT = "production"
DATABASE_URL = "postgresql+asyncpg://banking_app:PASSWORD@HOST/banking_nl2sql?ssl=require"
ANALYTICS_DATABASE_URL = "postgresql+asyncpg://banking_app:PASSWORD@HOST/banking_nl2sql?ssl=require"
OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-4.1-mini"
JWT_SECRET_KEY = "replace-with-a-long-random-secret"
SYNTHETIC_USER_PASSWORD = "replace-with-demo-login-password"
LOG_TO_CONSOLE = true
