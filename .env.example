OPENAI_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_TRACING_V2=
GROQ_API_KEY=
HF_TOKEN=
TAVILY_API_KEY=
APP_NAME=Banking NL2SQL API
ENVIRONMENT=development
API_BASE_URL=http://127.0.0.1:8000

# Create this dedicated database/user before using this value.
DATABASE_URL=postgresql+asyncpg://banking_app:change-me@127.0.0.1:5432/banking_nl2sql
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Separate PostgreSQL login with SELECT-only grants and read-only transactions.
ANALYTICS_DATABASE_URL=postgresql+asyncpg://banking_reader:change-me@127.0.0.1:5432/banking_nl2sql
ANALYTICS_STATEMENT_TIMEOUT_MS=10000

# Rotating application logs. Relative paths resolve from the project root.
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
LOG_FILENAME=banking_nl2sql.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=true

# Local synthetic users share this password only for the POC. Use a generated value.
SYNTHETIC_USER_PASSWORD=replace-with-a-generated-local-secret

# Generate a random value of at least 32 bytes for local JWT signing.
JWT_SECRET_KEY=replace-with-a-generated-local-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_ISSUER=banking-nl2sql-poc
JWT_AUDIENCE=banking-nl2sql-users
